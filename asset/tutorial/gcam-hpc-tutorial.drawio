                <mxCell id="12" value="&lt;b&gt;1  Sync to scratch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;rsync → gcam -scratch/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;GCAM inputs + user_batch_queries + shipped queries&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A4B7;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=12;" parent="GQW2o99OazQZEm_Rbnn_-38" vertex="1">
