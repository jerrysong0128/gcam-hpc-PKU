                <mxCell id="18" value="&lt;b&gt;Scenario task 0 … num_tasks−1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;run-task-wrapper.exe → run-scenario.sh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Creates isolated exe_N/ · runs gcam.exe with *_N.xml · writes output_N.txt&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#C96A2B;strokeWidth=1.8;fontFamily=Helvetica;fontSize=16;fontColor=#7A3512;align=left;verticalAlign=middle;spacingLeft=16;" parent="1" vertex="1">
