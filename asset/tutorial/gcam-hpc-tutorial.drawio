<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="RUN + QUERY architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="GCAM-HPC orchestration: RUN + QUERY" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=28;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="950" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="Configure QUERY before starting run-pipeline.sh; each scenario uses the same synced query set, then all CSV outputs are merged." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#52606D;" vertex="1" parent="1">
          <mxGeometry x="60" y="85" width="1180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="PRE-RUN CONFIGURATION" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#2A788E;" vertex="1" parent="1">
          <mxGeometry x="60" y="125" width="240" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="" style="rounded=1;arcSize=8;fillColor=#F6F8FA;strokeColor=#D8DEE4;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="1500" height="155" as="geometry"/>
        </mxCell>

        <mxCell id="6" value="&lt;b&gt;Scenario template&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;*_scenario_components.xml&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Base configuration and component slots&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8EA8B8;strokeWidth=1.4;fontFamily=Helvetica;fontSize=15;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="85" y="185" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Scenario batch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;*_batch_*.xml&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Choices expanded into scenario permutations&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8EA8B8;strokeWidth=1.4;fontFamily=Helvetica;fontSize=15;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="385" y="185" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;Generated query set&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;user_batch_queries/queries-YYYYmmdd-HHMMSS.xml&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Local-only query items and selected regions&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4F6;strokeColor=#2A788E;strokeWidth=1.6;fontFamily=Helvetica;fontSize=15;fontColor=#174A56;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="735" y="185" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;ModelInterface batch control&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;user_batch_queries/modelinterface-batch.xml&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Points to query set, XMLDB and per-scenario CSV output&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4F6;strokeColor=#2A788E;strokeWidth=1.6;fontFamily=Helvetica;fontSize=15;fontColor=#174A56;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1100" y="185" width="410" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="10" value="ORCHESTRATION" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#355C7D;" vertex="1" parent="1">
          <mxGeometry x="60" y="325" width="200" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;run-pipeline.sh&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#506176&quot;&gt;sources build-tools/environment.sh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#506176&quot;&gt;Create run directory · sync inputs and query XML · expand scenarios · generate SLURM job · submit RUN and dependent merge job&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#355C7D;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="50" y="350" width="1500" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="12" value="&lt;b&gt;1  Sync to scratch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;rsync → gcam-scratch/{input,output}/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;GCAM inputs + user_batch_queries + shipped queries&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A4B7;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="475" width="265" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;2  Expand scenarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;generate-scenarios.sh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Calls parse-scenario-batch.pl; writes one *_N.xml per scenario&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A4B7;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="365" y="475" width="265" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;3  Generate SLURM job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;slurm-templates/generated-run.slurm&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Adds one srun + run-task-wrapper.exe command per task&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A4B7;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="475" width="265" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;4  Submit RUN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;sbatch generated-run.slurm&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Parallel scenario tasks on the cluster&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A4B7;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="955" y="475" width="265" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;5  Schedule merge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;sbatch --dependency=afterok&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Starts merge-query-results.sh after the RUN job succeeds*&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A4B7;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1250" y="475" width="265" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="17" value="PARALLEL SCENARIO TASKS" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#C96A2B;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="250" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;Scenario task 0 … num_tasks−1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;run-task-wrapper.exe → run-scenario.sh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Creates isolated exe_N/ · runs gcam.exe with *_N.xml · writes output_N.txt&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#C96A2B;strokeWidth=1.8;fontFamily=Helvetica;fontSize=16;fontColor=#7A3512;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="630" width="620" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;Model run&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;gcam.exe -C*_N.xml&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Produces XMLDB at exe_N/db/database_basexdb&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F2;strokeColor=#D99254;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#7A3512;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="630" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;Per-scenario QUERY&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;ModelInterface.InterfaceMain&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Runs after gcam.exe returns (unconditionally); writes inter_query/*.csv&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF4F6;strokeColor=#2A788E;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#174A56;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="630" width="485" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="21" value="AGGREGATION" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#5F6B7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="765" width="180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;Collect and merge query results&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;merge-query-results.sh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Copies exe_N/inter_query/*.csv → out_query_N/; raw-concatenates all CSVs&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#667085;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="795" width="900" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;Final consolidated output&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;run_YYYYmmdd_HHMMSS/Final_&amp;lt;merge-jobid&amp;gt;.csv&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#667085&quot;&gt;*Current scripts do not strictly propagate GCAM/Java failures to Slurm.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4ED;strokeColor=#5B8C5A;strokeWidth=1.8;fontFamily=Helvetica;fontSize=15;fontColor=#315331;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1000" y="795" width="515" height="80" as="geometry"/>
        </mxCell>

