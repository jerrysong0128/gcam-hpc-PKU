                <mxCell id="13" value="&lt;b&gt;2  Expand scenarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;generate-scenarios.sh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Calls parse-scenario-batch.pl; writes one *_N.xml per scenario&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A4B7;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=12;" parent="GQW2o99OazQZEm_Rbnn_-38" vertex="1">
