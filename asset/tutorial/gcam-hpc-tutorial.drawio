                <mxCell id="11" value="&lt;b&gt;run-pipeline.sh&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#506176&quot;&gt;sources build-tools/environment.sh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#506176&quot;&gt;Create run directory · sync inputs and query XML · expand scenarios · generate SLURM job · submit RUN and dependent merge job&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=light-dark(#E8EEF5,#1C2228);strokeColor=#355C7D;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=18;" parent="1" vertex="1">
