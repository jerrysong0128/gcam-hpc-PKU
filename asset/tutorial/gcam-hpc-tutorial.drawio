                <mxCell id="15" value="&lt;b&gt;4  Submit RUN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;sbatch generated-run.slurm&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Parallel scenario tasks on the cluster&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A4B7;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=12;" parent="GQW2o99OazQZEm_Rbnn_-38" vertex="1">
                    <mxGeometry x="709" width="210" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="&lt;b&gt;5  Schedule merge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo;font-size:11px;color:#667085&quot;&gt;sbatch --dependency=afterok&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#667085&quot;&gt;Starts merge-query-results.sh after the RUN job succeeds*&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A4B7;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#25364D;align=left;verticalAlign=middle;spacingLeft=12;" parent="GQW2o99OazQZEm_Rbnn_-38" vertex="1">
